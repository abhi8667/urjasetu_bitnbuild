# UrjaSetu Engine — Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to git.
# Real environment variables always override values in this file.

# ================================================================== SIMULATION
# Days of meter feed to simulate (default 30)
URJASETU_DAYS=30

# Wall-clock seconds per streamed block (default 3.5)
URJASETU_STREAM_CADENCE_S=3.5

# Transformer derate multiplier — 1.0 = standard rating, 0.8 = force breach
URJASETU_DERATE=1.0

# ================================================================== SERVER
PORT=8000
CORS_ORIGINS=*

# ================================================================== LLM — PROVIDER SELECTION
# Which LLM provider to use: "watsonx" (IBM, default) or "groq" (legacy)
LLM_PROVIDER=watsonx

# Master switch: set true + fill provider credentials below to enable LLM features.
# When false, the engine runs on deterministic mathematical defaults (always safe).
URJASETU_LLM_ENABLED=true

# ================================================================== IBM watsonx.ai  [RECOMMENDED]
# Powers: daily trading strategy, breach diagnosis, operator Q&A (/api/ask)
# Sign up free at: https://cloud.ibm.com/catalog/services/watson-machine-learning
#
# Step 1 — IBM Cloud IAM API key (https://cloud.ibm.com/iam/apikeys → Create)
WATSONX_API_KEY=your_ibm_cloud_iam_api_key_here
#
# Step 2 — watsonx.ai Project ID
#   Open watsonx.ai → your project → Manage tab → General → Project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here
#
# Step 3 — Regional endpoint (choose the region where you provisioned the instance)
#   Dallas:    https://us-south.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   Tokyo:     https://jp-tok.ml.cloud.ibm.com
#   London:    https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
#
# Step 4 — Model to use (both are free on the Lite plan)
#   ibm/granite-3-3-8b-instruct                 (IBM Granite — compact & fast)
#   meta-llama/llama-3-2-11b-vision-instruct     (Meta Llama 3.2 11B)
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ================================================================== GROQ (legacy — kept for gradual migration)
# Only used when LLM_PROVIDER=groq. Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# ================================================================== IBM App Configuration  [FEATURE FLAGS]
# Live feature-flag dashboard — flip llm_enabled, risk_enabled, derate_factor
# without redeploying. Free Lite plan: 10 flags, 5K API calls/month.
# Sign up at: https://cloud.ibm.com/catalog/services/app-configuration
#
# Service credentials → API key (or reuse your WATSONX_API_KEY if same IBM Cloud account)
APPCONFIGURATION_API_KEY=your_appconfiguration_api_key_here
#
# Instance GUID — shown on the App Configuration service instance page
APPCONFIGURATION_INSTANCE_ID=your_appconfiguration_instance_guid_here
#
# Region: us-south | eu-de | au-syd | jp-tok | eu-gb
APPCONFIGURATION_REGION=us-south
#
# Collection ID you created in App Configuration (e.g. "urjasetu-engine")
APPCONFIGURATION_COLLECTION_ID=urjasetu-engine
#
# Environment ID you created (e.g. "dev" or "production")
APPCONFIGURATION_ENVIRONMENT_ID=dev

# ================================================================== IBM Cloud Code Engine  [DEPLOYMENT]
# Set to "true" when running inside IBM Code Engine.
# Suppresses the Render keep-alive pinger (Code Engine does not sleep).
IBM_CODE_ENGINE=false

# ================================================================== KEEP-ALIVE (Render legacy)
# Ping this URL every 5 min to prevent Render free-tier sleep.
# Automatically disabled when IBM_CODE_ENGINE=true.
KEEP_ALIVE_URL=
