# UrjaSetu environment configuration.
#
# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env
#
# On Render, set these in the dashboard (Environment -> Environment Variables)
# instead of committing a file.

# ---------------------------------------------------------------- LLM agents
# Groq API key. Get one free at https://console.groq.com/keys
# Leave blank and the engine runs fully on its deterministic defaults — the LLM
# layer is strictly advisory and every call falls back (PRD integration check 10).
GROQ_API_KEY=

# Set to true to actually call Groq. With no key this stays off regardless.
URJASETU_LLM_ENABLED=false

# Model used for the three LLM call sites. openai/gpt-oss-20b is fast and cheap;
# llama-3.3-70b-versatile is stronger for the narration call.
GROQ_MODEL=llama-3.3-70b-versatile

# Seconds before an LLM call gives up and the deterministic fallback takes over.
GROQ_TIMEOUT_SECONDS=6

# ------------------------------------------------------------------- server
# Port uvicorn binds. Render injects this automatically; local default is 8000.
PORT=8000

# Comma-separated origins allowed to open a WebSocket / fetch the REST API.
# "*" is fine for a demo. For production put your Vercel URL here, e.g.
#   CORS_ORIGINS=https://urjasetu.vercel.app
CORS_ORIGINS=*

# How many simulated days the engine runs at boot. 30 is the PRD figure and
# takes about 3 seconds.
URJASETU_DAYS=30

# Seconds of wall clock per simulated block when streaming to the UI.
URJASETU_STREAM_CADENCE_S=3.5

# Transformer derate factor. 1.0 is the shipped dataset; 0.8 forces harder
# breaches for a demo.
URJASETU_DERATE=1.0
