# UrjaSetu Engine Configuration
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------ LLM AGENTS
# Set to 'true' to enable Groq LLM agent bidding strategy advisors.
# If false, the engine runs on deterministic mathematical defaults.
URJASETU_LLM_ENABLED=true

# Your Groq API key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (default is llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------ SIMULATION
# Days of meter feed to simulate (default is 30)
URJASETU_DAYS=30

# Wall clock seconds per simulated block
URJASETU_STREAM_CADENCE_S=3.5

# Transformer derate multiplier (1.0 is standard rating)
URJASETU_DERATE=1.0

# ------------------------------------------------------------------ SERVER
PORT=8000
CORS_ORIGINS=*
