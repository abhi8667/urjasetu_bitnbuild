# UI build-time configuration (Vite). Copy to .env.local for local dev.
#
# On Vercel set these in Project Settings -> Environment Variables instead.
#
# The engine's public origin. Must be https in production: a page served from
# Vercel over HTTPS cannot open a plaintext ws:// socket, and the browser blocks
# it with no visible error. The UI derives wss:// from this automatically.
VITE_ENGINE_URL=https://urjasetu-engine.onrender.com

# Seconds of wall clock per simulated block.
VITE_STREAM_CADENCE=3.5

# Simulated days to request from the engine.
VITE_STREAM_DAYS=30

# Block to open on. 10 is 10:00 on day one — solar export and trading are
# visible immediately.
VITE_STREAM_START=10
